@model OrderDetailsPageViewModel
@{
    ViewData["Title"] = Model.Order.OrderNumber;
    ViewData["PageTitle"] = Model.Order.OrderNumber;
}

<section class="hero-panel">
    <div>
        <div class="eyebrow">Commerce</div>
        <h2>@Model.Order.OrderNumber</h2>
        <p>@Model.Order.Email</p>
    </div>
    <div class="hero-meta">
        <span class="status-pill">@Model.Order.Status</span>
        <span>Payment: @Model.Order.PaymentStatus</span>
        <span>Placed @Model.Order.PlacedAtUtc.ToString("yyyy-MM-dd HH:mm")</span>
    </div>
</section>

<div class="two-column-grid">
    <section class="panel">
        <h3>Overview</h3>
        <div class="table-wrap">
            <table class="data-table">
                <tbody>
                    <tr>
                        <th>Source Cart</th>
                        <td>@(Model.Order.SourceCartId?.ToString() ?? "Manual")</td>
                    </tr>
                    <tr>
                        <th>Customer</th>
                        <td>@(Model.Order.CustomerId?.ToString() ?? "Anonymous")</td>
                    </tr>
                    <tr>
                        <th>Company</th>
                        <td>@(Model.Order.CompanyId?.ToString() ?? "None")</td>
                    </tr>
                    <tr>
                        <th>Market</th>
                        <td>@Model.Order.MarketId</td>
                    </tr>
                    <tr>
                        <th>Subtotal</th>
                        <td>@Model.Order.Subtotal.ToString("0.00")</td>
                    </tr>
                    <tr>
                        <th>VAT</th>
                        <td>@Model.Order.VatTotal.ToString("0.00")</td>
                    </tr>
                    <tr>
                        <th>Total</th>
                        <td>@Model.Order.GrandTotal.ToString("0.00")</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>

    <section class="panel">
        <h3>Update Status</h3>
        <form method="post" asp-action="ChangeStatus" asp-route-id="@Model.Order.Id" class="editor-grid compact-grid">
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
            <input asp-for="StatusForm.OrderId" type="hidden" />
            <input asp-for="StatusForm.RowVersion" type="hidden" />

            <label class="field">
                <span>To Status</span>
                <select asp-for="StatusForm.ToStatus">
                    @foreach (var status in Model.StatusForm.StatusOptions)
                    {
                        <option value="@status">@status</option>
                    }
                </select>
            </label>

            <label class="field field-full">
                <span>Comment</span>
                <textarea asp-for="StatusForm.Comment" rows="3"></textarea>
            </label>

            <div class="form-actions">
                <button type="submit" class="button button-primary">Save Status</button>
                <a asp-action="Index" class="button button-ghost">Back</a>
            </div>
        </form>
    </section>
</div>

<div class="two-column-grid">
    <section class="panel">
        <div class="panel-toolbar">
            <h3>Lines</h3>
            <div class="topbar-meta">@Model.Order.Lines.Count item(s)</div>
        </div>

        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Variant</th>
                        <th>Quantity</th>
                        <th>Unit Price</th>
                        <th>VAT</th>
                        <th>Line Total</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var line in Model.Order.Lines)
                {
                    <tr>
                        <td>
                            <a asp-controller="Variants" asp-action="Details" asp-route-id="@line.VariantId" class="table-primary">@line.Sku</a>
                            <div class="table-secondary">@line.ProductName</div>
                        </td>
                        <td>@line.Quantity</td>
                        <td>@line.UnitPrice.ToString("0.00")</td>
                        <td>@line.VatRate.ToString("0.00")</td>
                        <td>@line.LineTotal.ToString("0.00")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>

    <section class="panel">
        <div class="panel-toolbar">
            <h3>Addresses</h3>
            <div class="topbar-meta">Order snapshot</div>
        </div>

        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Type</th>
                        <th>Contact</th>
                        <th>Address</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var address in Model.Order.Addresses)
                {
                    <tr>
                        <td>@address.Type</td>
                        <td>
                            <div class="table-primary">@address.FirstName @address.LastName</div>
                            <div class="table-secondary">@address.Email</div>
                        </td>
                        <td>@address.Line1, @address.PostalCode @address.City</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>
</div>

<div class="two-column-grid">
    <section class="panel">
        <div class="panel-toolbar">
            <h3>Status History</h3>
            <div class="topbar-meta">Operational changes</div>
        </div>

        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Time</th>
                        <th>From</th>
                        <th>To</th>
                        <th>Changed By</th>
                        <th>Comment</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var history in Model.Order.StatusHistory)
                {
                    <tr>
                        <td>@history.ChangedAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@(history.FromStatus ?? "None")</td>
                        <td>@history.ToStatus</td>
                        <td>@history.ChangedBy</td>
                        <td>@history.Comment</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>

    <section class="panel">
        <div class="panel-toolbar">
            <h3>Add Payment Transaction</h3>
            <div class="topbar-meta">Record external payment activity</div>
        </div>

        <form method="post" asp-action="AddPaymentTransaction" asp-route-id="@Model.Order.Id" class="editor-grid compact-grid">
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
            <input asp-for="PaymentForm.OrderId" type="hidden" />
            <input asp-for="PaymentForm.RowVersion" type="hidden" />

            <label class="field">
                <span>Provider</span>
                <input asp-for="PaymentForm.Provider" />
            </label>

            <label class="field">
                <span>Reference</span>
                <input asp-for="PaymentForm.ProviderReference" />
            </label>

            <label class="field">
                <span>Type</span>
                <select asp-for="PaymentForm.Type">
                    @foreach (var type in Model.PaymentForm.TypeOptions)
                    {
                        <option value="@type">@type</option>
                    }
                </select>
            </label>

            <label class="field">
                <span>Status</span>
                <select asp-for="PaymentForm.Status">
                    @foreach (var status in Model.PaymentForm.StatusOptions)
                    {
                        <option value="@status">@status</option>
                    }
                </select>
            </label>

            <label class="field">
                <span>Amount</span>
                <input asp-for="PaymentForm.Amount" />
            </label>

            <label class="field">
                <span>Currency</span>
                <input asp-for="PaymentForm.CurrencyCode" />
            </label>

            <label class="field">
                <span>Requested At</span>
                <input asp-for="PaymentForm.RequestedAtUtc" type="datetime-local" value="@Model.PaymentForm.RequestedAtUtc.ToString("yyyy-MM-ddTHH:mm")" />
            </label>

            <label class="field">
                <span>Completed At</span>
                <input asp-for="PaymentForm.CompletedAtUtc" type="datetime-local" value="@(Model.PaymentForm.CompletedAtUtc?.ToString("yyyy-MM-ddTHH:mm"))" />
            </label>

            <div class="form-actions">
                <button type="submit" class="button button-secondary">Record Payment</button>
            </div>
        </form>

        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Provider</th>
                        <th>Status</th>
                        <th>Amount</th>
                        <th>Requested</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Order.PaymentTransactions.Count == 0)
                {
                    <tr>
                        <td colspan="4" class="empty-state">No payment transactions yet.</td>
                    </tr>
                }
                else
                {
                    @foreach (var transaction in Model.Order.PaymentTransactions)
                    {
                        <tr>
                            <td>
                                <div class="table-primary">@transaction.Provider</div>
                                <div class="table-secondary">@transaction.ProviderReference</div>
                            </td>
                            <td>@transaction.Status</td>
                            <td>@transaction.Amount.ToString("0.00") @transaction.CurrencyCode</td>
                            <td>@transaction.RequestedAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </section>
</div>
