@model CartDetailsPageViewModel
@{
    ViewData["Title"] = $"Cart {Model.Cart.Id}";
    ViewData["PageTitle"] = "Cart Details";
}

<section class="hero-panel">
    <div>
        <div class="eyebrow">Commerce</div>
        <h2>Cart @Model.Cart.Id</h2>
        <p>@(Model.Cart.Email ?? "No email attached")</p>
    </div>
    <div class="hero-meta">
        <span class="status-pill">@Model.Cart.Status</span>
        <span>@Model.Cart.CurrencyCode / @Model.Cart.CultureCode</span>
        <span>Updated @Model.Cart.UpdatedAtUtc.ToString("yyyy-MM-dd HH:mm")</span>
    </div>
</section>

<div class="two-column-grid">
    <section class="panel">
        <h3>Overview</h3>
        <div class="table-wrap">
            <table class="data-table">
                <tbody>
                    <tr>
                        <th>Customer</th>
                        <td>@(Model.Cart.CustomerId?.ToString() ?? "Anonymous")</td>
                    </tr>
                    <tr>
                        <th>Company</th>
                        <td>@(Model.Cart.CompanyId?.ToString() ?? "None")</td>
                    </tr>
                    <tr>
                        <th>Market</th>
                        <td>@Model.Cart.MarketId</td>
                    </tr>
                    <tr>
                        <th>Subtotal</th>
                        <td>@Model.Cart.Subtotal.ToString("0.00")</td>
                    </tr>
                    <tr>
                        <th>VAT</th>
                        <td>@Model.Cart.VatTotal.ToString("0.00")</td>
                    </tr>
                    <tr>
                        <th>Grand total</th>
                        <td>@Model.Cart.GrandTotal.ToString("0.00")</td>
                    </tr>
                    <tr>
                        <th>Expires</th>
                        <td>@(Model.Cart.ExpiresAtUtc?.ToString("yyyy-MM-dd HH:mm") ?? "N/A")</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>

    <section class="panel">
        <h3>Actions</h3>
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        @if (Model.Cart.Status == "Active")
        {
            <form method="post" asp-action="Reprice" asp-route-id="@Model.Cart.Id" class="inline-danger-form">
                <input asp-for="RepriceForm.CartId" type="hidden" />
                <input asp-for="RepriceForm.RowVersion" type="hidden" />
                <button type="submit" class="button button-secondary">Reprice Cart</button>
            </form>

            <form method="post" asp-action="Expire" asp-route-id="@Model.Cart.Id" class="inline-danger-form">
                <input asp-for="ExpireForm.CartId" type="hidden" />
                <input asp-for="ExpireForm.RowVersion" type="hidden" />
                <button type="submit" class="button button-danger">Expire Cart</button>
            </form>

            <form method="post" asp-action="CreateOrder" asp-route-id="@Model.Cart.Id" class="inline-danger-form">
                <input asp-for="CreateOrderForm.CartId" type="hidden" />
                <input asp-for="CreateOrderForm.RowVersion" type="hidden" />
                <button type="submit" class="button button-primary">Create Order</button>
            </form>
        }

        <a asp-action="Index" class="button button-ghost">Back</a>
    </section>
</div>

<div class="two-column-grid">
    <section class="panel">
        <div class="panel-toolbar">
            <h3>Lines</h3>
            <div class="topbar-meta">@Model.Cart.Lines.Count item(s)</div>
        </div>

        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Variant</th>
                        <th>Quantity</th>
                        <th>Unit Price</th>
                        <th>VAT</th>
                        <th>Line Total</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Cart.Lines.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="empty-state">No lines in this cart.</td>
                    </tr>
                }
                else
                {
                    @foreach (var line in Model.Cart.Lines)
                    {
                        <tr>
                            <td>
                                <a asp-controller="Variants" asp-action="Details" asp-route-id="@line.VariantId" class="table-primary">@line.Sku</a>
                                <div class="table-secondary">@line.ProductName</div>
                            </td>
                            <td>@line.Quantity</td>
                            <td>@line.UnitPrice.ToString("0.00")</td>
                            <td>@line.VatRate.ToString("0.00")</td>
                            <td>@line.LineTotal.ToString("0.00")</td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </section>

    <section class="panel">
        <div class="panel-toolbar">
            <h3>Addresses</h3>
            <div class="topbar-meta">Captured cart addresses</div>
        </div>

        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Type</th>
                        <th>Contact</th>
                        <th>Address</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Cart.Addresses.Count == 0)
                {
                    <tr>
                        <td colspan="3" class="empty-state">No addresses captured.</td>
                    </tr>
                }
                else
                {
                    @foreach (var address in Model.Cart.Addresses)
                    {
                        <tr>
                            <td>@address.Type</td>
                            <td>
                                <div class="table-primary">@address.FirstName @address.LastName</div>
                                <div class="table-secondary">@address.Email</div>
                            </td>
                            <td>@address.Line1, @address.PostalCode @address.City</td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </section>
</div>
