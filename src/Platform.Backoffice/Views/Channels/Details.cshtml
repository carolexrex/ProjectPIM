@model ChannelDetailsPageViewModel
@{
    ViewData["Title"] = Model.Channel.Code;
    ViewData["PageTitle"] = Model.Channel.Code;
}

<section class="hero-panel">
    <div>
        <div class="eyebrow">Channel</div>
        <h2>@Model.Channel.Code</h2>
        <p>@Model.Channel.Name</p>
        <p>@(string.IsNullOrWhiteSpace(Model.Channel.HostName) ? "No host configured" : Model.Channel.HostName)</p>
    </div>
    <div class="hero-meta">
        <span class="status-pill">@Model.Channel.Status</span>
        <span>@Model.Markets.Count assigned markets</span>
        <span>Updated @Model.Channel.UpdatedAtUtc.ToString("yyyy-MM-dd HH:mm")</span>
    </div>
</section>

<div class="two-column-grid">
    <section class="panel">
        <h3>Edit Channel</h3>
        <form method="post" asp-action="Update" asp-route-id="@Model.Channel.Id" class="editor-grid compact-grid">
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
            <input asp-for="Channel.Id" type="hidden" />
            <input asp-for="Channel.RowVersion" type="hidden" />

            <label class="field">
                <span>Code</span>
                <input asp-for="Channel.Code" />
                <span asp-validation-for="Channel.Code" class="field-error"></span>
            </label>

            <label class="field">
                <span>Name</span>
                <input asp-for="Channel.Name" />
                <span asp-validation-for="Channel.Name" class="field-error"></span>
            </label>

            <label class="field">
                <span>Host Name</span>
                <input asp-for="Channel.HostName" />
                <span asp-validation-for="Channel.HostName" class="field-error"></span>
            </label>

            <div class="form-actions">
                <button type="submit" class="button button-primary">Save Channel</button>
                <a asp-action="Index" class="button button-ghost">Back</a>
            </div>
        </form>

        @if (!string.Equals(Model.Channel.Status, "Archived", StringComparison.OrdinalIgnoreCase))
        {
            <form method="post" asp-action="Archive" asp-route-id="@Model.Channel.Id" class="inline-danger-form">
                <button type="submit" class="button button-danger">Archive Channel</button>
            </form>
        }
    </section>

    <section class="panel">
        <div class="panel-toolbar">
            <h3>Assigned Markets</h3>
            <div class="topbar-meta">Connect sales endpoints to market availability</div>
        </div>

        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Market</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Markets.Count == 0)
                {
                    <tr>
                        <td colspan="2" class="empty-state">No markets assigned yet.</td>
                    </tr>
                }
                else
                {
                    @foreach (var market in Model.Markets)
                    {
                        <tr>
                            <td>
                                <div class="table-primary">@market.MarketCode</div>
                                <div class="table-secondary">@market.MarketName</div>
                            </td>
                            <td class="action-cell">
                                <form method="post" asp-action="RemoveMarketAssignment" asp-route-id="@Model.Channel.Id" asp-route-marketId="@market.MarketId">
                                    <input type="hidden" name="rowVersion" value="@Model.Channel.RowVersion" />
                                    <button type="submit" class="button button-ghost">Remove</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>

        <form method="post" asp-action="UpsertMarketAssignment" asp-route-id="@Model.Channel.Id" class="editor-grid compact-grid">
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
            <input asp-for="MarketAssignmentForm.ChannelId" type="hidden" />
            <input asp-for="MarketAssignmentForm.RowVersion" type="hidden" />

            <label class="field field-full">
                <span>Market</span>
                <select asp-for="MarketAssignmentForm.MarketId">
                    <option value="">Select market</option>
                    @foreach (var market in Model.MarketAssignmentForm.MarketOptions)
                    {
                        <option value="@market.Id">@market.Label</option>
                    }
                </select>
                <span asp-validation-for="MarketAssignmentForm.MarketId" class="field-error"></span>
            </label>

            <div class="form-actions">
                <button type="submit" class="button button-secondary">Assign Market</button>
            </div>
        </form>
    </section>
</div>
