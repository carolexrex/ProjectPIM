@model PriceListDetailsPageViewModel
@{
    ViewData["Title"] = Model.PriceList.Code;
    ViewData["PageTitle"] = Model.PriceList.Code;
}

<section class="hero-panel">
    <div>
        <div class="eyebrow">Pricing</div>
        <h2>@Model.PriceList.Code</h2>
        <p>@Model.PriceList.Name</p>
    </div>
    <div class="hero-meta">
        <span class="status-pill">@Model.PriceList.Status</span>
        <span>@Model.PriceList.CurrencyCode</span>
        <span>Updated @Model.PriceList.UpdatedAtUtc.ToString("yyyy-MM-dd HH:mm")</span>
    </div>
</section>

<div class="two-column-grid">
    <section class="panel">
        <h3>Edit Price List</h3>
        <form method="post" asp-action="Update" asp-route-id="@Model.PriceList.Id" class="editor-grid compact-grid">
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
            <input asp-for="PriceList.Id" type="hidden" />
            <input asp-for="PriceList.RowVersion" type="hidden" />

            <label class="field">
                <span>Code</span>
                <input asp-for="PriceList.Code" />
                <span asp-validation-for="PriceList.Code" class="field-error"></span>
            </label>

            <label class="field">
                <span>Name</span>
                <input asp-for="PriceList.Name" />
                <span asp-validation-for="PriceList.Name" class="field-error"></span>
            </label>

            <label class="field">
                <span>Currency</span>
                <input asp-for="PriceList.CurrencyCode" />
                <span asp-validation-for="PriceList.CurrencyCode" class="field-error"></span>
            </label>

            <label class="field field-checkbox">
                <input asp-for="PriceList.VatIncluded" />
                <span>VAT included</span>
            </label>

            <label class="field">
                <span>Valid From UTC</span>
                <input asp-for="PriceList.ValidFromUtc" type="datetime-local" />
            </label>

            <label class="field">
                <span>Valid To UTC</span>
                <input asp-for="PriceList.ValidToUtc" type="datetime-local" />
            </label>

            <div class="form-actions">
                <button type="submit" class="button button-primary">Save Price List</button>
                <a asp-action="Index" class="button button-ghost">Back</a>
            </div>
        </form>

        @if (!string.Equals(Model.PriceList.Status, "Archived", StringComparison.OrdinalIgnoreCase))
        {
            <form method="post" asp-action="Archive" asp-route-id="@Model.PriceList.Id" class="inline-danger-form">
                <button type="submit" class="button button-danger">Archive Price List</button>
            </form>
        }
    </section>

    <section class="panel">
        <div class="panel-toolbar">
            <h3>Coverage</h3>
            <div class="topbar-meta">Small action blocks work better on a phone than dense master-detail pages</div>
        </div>

        <div class="stat-strip">
            <div class="stat-card">
                <span class="stat-label">Markets</span>
                <strong>@Model.Markets.Count</strong>
            </div>
            <div class="stat-card">
                <span class="stat-label">Entries</span>
                <strong>@Model.Entries.Count</strong>
            </div>
            <div class="stat-card">
                <span class="stat-label">VAT mode</span>
                <strong>@(Model.PriceList.VatIncluded ? "Included" : "Excluded")</strong>
            </div>
        </div>
    </section>
</div>

<div class="two-column-grid">
    <section class="panel">
        <div class="panel-toolbar">
            <h3>Assigned Markets</h3>
            <div class="topbar-meta">Only markets with matching currency are offered</div>
        </div>

        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Market</th>
                        <th>Priority</th>
                        <th>Base</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Markets.Count == 0)
                {
                    <tr>
                        <td colspan="4" class="empty-state">No markets assigned.</td>
                    </tr>
                }
                else
                {
                    @foreach (var market in Model.Markets)
                    {
                        <tr>
                            <td>
                                <div class="table-primary">@market.MarketCode</div>
                                <div class="table-secondary">@market.MarketName</div>
                            </td>
                            <td>@market.Priority</td>
                            <td>@(market.IsBasePriceList ? "Yes" : "No")</td>
                            <td class="action-cell">
                                <form method="post" asp-action="RemoveMarketAssignment" asp-route-id="@Model.PriceList.Id" asp-route-marketId="@market.MarketId">
                                    <input type="hidden" name="rowVersion" value="@Model.PriceList.RowVersion" />
                                    <button type="submit" class="button button-ghost">Remove</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>

        <form method="post" asp-action="UpsertMarketAssignment" asp-route-id="@Model.PriceList.Id" class="editor-grid compact-grid">
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
            <input asp-for="MarketAssignmentForm.PriceListId" type="hidden" />
            <input asp-for="MarketAssignmentForm.RowVersion" type="hidden" />

            <label class="field field-full">
                <span>Market</span>
                <select asp-for="MarketAssignmentForm.MarketId">
                    <option value="">Select market</option>
                    @foreach (var market in Model.MarketAssignmentForm.MarketOptions)
                    {
                        <option value="@market.Id">@market.Label</option>
                    }
                </select>
                <span asp-validation-for="MarketAssignmentForm.MarketId" class="field-error"></span>
            </label>

            <label class="field">
                <span>Priority</span>
                <input asp-for="MarketAssignmentForm.Priority" />
            </label>

            <label class="field field-checkbox">
                <input asp-for="MarketAssignmentForm.IsBasePriceList" />
                <span>Base price list</span>
            </label>

            <div class="form-actions">
                <button type="submit" class="button button-secondary">Assign Market</button>
            </div>
        </form>
    </section>

    <section class="panel">
        <div class="panel-toolbar">
            <h3>Price Entries</h3>
            <div class="topbar-meta">Variant-level pricing for now</div>
        </div>

        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Variant</th>
                        <th>Qty</th>
                        <th>Price</th>
                        <th>Window</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Entries.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="empty-state">No price entries yet.</td>
                    </tr>
                }
                else
                {
                    @foreach (var entry in Model.Entries)
                    {
                        <tr>
                            <td>@entry.TargetLabel</td>
                            <td>@entry.MinQuantity</td>
                            <td>
                                <div class="table-primary">@entry.Amount.ToString("0.00")</div>
                                <div class="table-secondary">Compare at @(entry.CompareAtAmount?.ToString("0.00") ?? "-")</div>
                            </td>
                            <td>
                                <div class="table-primary">@(entry.ValidFromUtc?.ToString("yyyy-MM-dd HH:mm") ?? "Immediate")</div>
                                <div class="table-secondary">@(entry.ValidToUtc?.ToString("yyyy-MM-dd HH:mm") ?? "No end")</div>
                            </td>
                            <td class="action-cell">
                                <form method="post" asp-action="RemoveEntry" asp-route-id="@Model.PriceList.Id" asp-route-entryId="@entry.Id">
                                    <input type="hidden" name="rowVersion" value="@Model.PriceList.RowVersion" />
                                    <button type="submit" class="button button-ghost">Remove</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>

        <form method="post" asp-action="UpsertEntry" asp-route-id="@Model.PriceList.Id" class="editor-grid compact-grid">
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
            <input asp-for="EntryForm.PriceListId" type="hidden" />
            <input asp-for="EntryForm.RowVersion" type="hidden" />

            <label class="field field-full">
                <span>Variant</span>
                <select asp-for="EntryForm.TargetId">
                    <option value="">Select variant</option>
                    @foreach (var variant in Model.EntryForm.VariantOptions)
                    {
                        <option value="@variant.Id">@variant.Label</option>
                    }
                </select>
                <span asp-validation-for="EntryForm.TargetId" class="field-error"></span>
            </label>

            <label class="field">
                <span>Minimum Quantity</span>
                <input asp-for="EntryForm.MinQuantity" />
            </label>

            <label class="field">
                <span>Amount</span>
                <input asp-for="EntryForm.Amount" />
                <span asp-validation-for="EntryForm.Amount" class="field-error"></span>
            </label>

            <label class="field">
                <span>Compare At Amount</span>
                <input asp-for="EntryForm.CompareAtAmount" />
            </label>

            <label class="field">
                <span>Valid From UTC</span>
                <input asp-for="EntryForm.ValidFromUtc" type="datetime-local" />
            </label>

            <label class="field">
                <span>Valid To UTC</span>
                <input asp-for="EntryForm.ValidToUtc" type="datetime-local" />
            </label>

            <div class="form-actions">
                <button type="submit" class="button button-secondary">Save Entry</button>
            </div>
        </form>
    </section>
</div>
