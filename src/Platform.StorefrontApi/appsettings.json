{
  "Persistence": {
    "Provider": "InMemory"
  },
  "ConnectionStrings": {
    "Platform": ""
  },
  "StorefrontSecurity": {
    "Cors": {
      "AllowedOrigins": []
    },
    "RateLimiting": {
      "Enabled": true,
      "PermitLimit": 300,
      "WindowSeconds": 60
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
