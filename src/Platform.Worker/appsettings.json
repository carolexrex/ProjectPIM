{
  "Persistence": {
    "Provider": "InMemory"
  },
  "ConnectionStrings": {
    "Platform": ""
  },
  "Webhooks": {
    "ManualReplayEnabled": false,
    "ManualReplayDelaySeconds": 300
  },
  "Worker": {
    "IntegrationJobs": {
      "PollIntervalSeconds": 10,
      "MaxJobsPerCycle": 5,
      "MaxStorefrontProjectionRefreshMessagesPerCycle": 20,
      "MaxOutboxMessagesPerCycle": 10,
      "MaxWebhookDeliveriesPerCycle": 10,
      "StorefrontPriceValidityRefreshEnabled": true,
      "StorefrontPriceValidityScanIntervalSeconds": 60,
      "StorefrontPriceValidityLookbackMinutes": 1440,
      "MaxStorefrontPriceValidityProductsPerCycle": 100
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
